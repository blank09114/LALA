package com.example.lala.DTO.Lms;

import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

/**
 * 🎓 수강중인 강의 정보 DTO
 * 사용자가 수강중인 강의 목록을 조회할 때 사용
 */
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
public class MyLectureInfo {
    
    /**
     * 강의 ID
     */
    private String lectureId;
    
    /**
     * 강의 제목
     */
    private String title;
    
    /**
     * 강의 썸네일 이미지 경로
     */
    private String thumbnail;
    
    /**
     * 강의 업로더(강사) ID
     */
    private String uploaderId;
    
    /**
     * 강사 닉네임
     */
    private String nickname;
    
    /**
     * 강의 개요
     */
    private String outline;
    
    /**
     * 수강 진도율 (0.0 ~ 100.0)
     */
    private Float progressRate;
    
    /**
     * 대분류 카테고리 (예: IT/개발, 비즈니스)
     */
    private String big;
    
    /**
     * 소분류 카테고리 (예: 웹 개발, 모바일 앱 개발)
     */
    private String small;
    
    /**
     * 강의 난이도 (1: 초급, 2: 중급, 3: 고급)
     */
    private Integer difficulty;
    
    /**
     * 마지막 수강 날짜 (진도율 업데이트 날짜 또는 수강 등록일)
     */
    private String lastUpdateDate;
    
    /**
     * 난이도를 문자열로 반환하는 헬퍼 메서드
     * @return 난이도 문자열
     */
    public String getDifficultyText() {
        if (difficulty == null) return "정보 없음";
        switch (difficulty) {
            case 1: return "초급";
            case 2: return "중급"; 
            case 3: return "고급";
            default: return "정보 없음";
        }
    }
    
    /**
     * 진도율을 백분율 문자열로 반환하는 헬퍼 메서드
     * @return 진도율 문자열 (예: "75.5%")
     */
    public String getProgressRateText() {
        if (progressRate == null) return "0%";
        return String.format("%.1f%%", progressRate);
    }
    
    /**
     * 진도율에 따른 상태를 반환하는 헬퍼 메서드
     * @return 진도 상태 문자열
     */
    public String getProgressStatus() {
        if (progressRate == null || progressRate == 0.0f) {
            return "시작 전";
        } else if (progressRate < 30.0f) {
            return "수강 시작";
        } else if (progressRate < 70.0f) {
            return "수강 중";
        } else if (progressRate < 100.0f) {
            return "거의 완료";
        } else {
            return "수강 완료";
        }
    }
    
    /**
     * 카테고리 정보를 조합해서 반환하는 헬퍼 메서드
     * @return 카테고리 문자열 (예: "IT/개발 > 웹 개발")
     */
    public String getCategoryText() {
        if (big == null && small == null) return "카테고리 없음";
        if (big == null) return small;
        if (small == null) return big;
        return big + " > " + small;
    }
    
    /**
     * LMS 접근 URL을 생성하는 헬퍼 메서드
     * @return LMS URL
     */
    public String getLmsUrl() {
        return "/lms/main/" + lectureId;
    }
}